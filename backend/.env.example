# LLM API Configuration (OpenAI-compatible)
# This app works with ANY OpenAI API-compatible provider!

# Ollama (default in devcontainer - runs as separate Docker service)
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama  # Required but ignored by Ollama
LLM_MODEL=gemma3:4b

# Thinking models (qwen3, DeepSeek V4, etc.): "none" puts the answer in
# content instead of burning the token budget on reasoning (empty Ask answers).
# Use low|medium|high to allow thinking, or leave blank to omit the field.
LLM_REASONING_EFFORT=none

# Optional per-path overrides (fall back to LLM_REASONING_EFFORT, then none).
# ASK_REASONING_EFFORT=none
# CHAT_REASONING_EFFORT=none
# COMPARE_REASONING_EFFORT=none
# EXTRACT_REASONING_EFFORT=none
# VOICE_REASONING_EFFORT=none
# COMPACT_REASONING_EFFORT=none
# Judge reviews short claims — keep thinking off unless you have a reason.
# JUDGE_REASONING_EFFORT=none

# Ask / Chat generation ceilings (defaults 4096). Raise if high effort truncates.
# ASK_MAX_TOKENS=4096
# CHAT_MAX_TOKENS=4096

# Examples for other providers:
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1, LLM_API_KEY=lm-studio, LLM_MODEL=your-model
# DeepSeek (chat) + keep embeddings on Ollama — never commit real API keys:
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=sk-your-key
#   LLM_MODEL=deepseek-v4-flash
#   LLM_REASONING_EFFORT=high
#   ASK_REASONING_EFFORT=none
#   JUDGE_MODEL=deepseek-v4-flash
#   JUDGE_REASONING_EFFORT=none
#   EMBEDDING_BASE_URL=http://ollama:11434/v1
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=nomic-embed-text

# Whisper Configuration (local speech-to-text)
WHISPER_MODEL=base.en

# PostgreSQL (pgvector image)
DATABASE_URL=postgresql+asyncpg://researchpilot:researchpilot@postgres:5432/researchpilot

# Local embeddings via Ollama (OpenAI-compatible /v1/embeddings)
# When LLM_BASE_URL points at a cloud chat API (DeepSeek, etc.), keep
# embeddings on Ollama — cloud providers usually do not host nomic-embed-text.
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Hugging Face cache (Whisper / tokenizers)
HF_HOME=/workspaces/researchpilot/.cache/huggingface

# GROBID academic PDF parser (runs as a Docker service in the devcontainer)
GROBID_URL=http://grobid:8070
GROBID_TIMEOUT=180

# Uploaded paper and note PDFs
PAPERS_DIR=data/papers
NOTES_DIR=data/notes

# Ask My Research: cosine similarity below this is dropped before OK-quality
# generation and marks ordinary questions as weak/cautious evidence.
# nomic-embed-text scores around 0.6 are topical overlap, not answerability.
# Field-wide / SOTA questions use coverage (paper count, years), not a higher
# default threshold.
ASK_MIN_SIMILARITY=0.35

# Hybrid retrieval rerank (off by default — first enable downloads a Tiny ONNX model)
# RERANK_ENABLED=false
# RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Chat web search via DeepSeek Responses API (independent of LLM_BASE_URL).
# Empty / ollama / changeme / none count as unset — paste a real sk- key.
WEB_SEARCH_BASE_URL=https://api.deepseek.com
WEB_SEARCH_API_KEY=
WEB_SEARCH_MODEL=deepseek-v4-flash

# Comet Opik tracing for Ask/Chat (JSONL always written to data/traces/)
# OPIK_API_KEY=
# OPIK_WORKSPACE=
# OPIK_PROJECT_NAME=knowledgehub-ask
# Optional USD estimates when usage tokens are present (Ollama stays 0)
# USD_PER_1K_INPUT=0
# USD_PER_1K_OUTPUT=0

# Chat agent evidence gate: cheap deterministic checks (fabricated [n], answers
# written without opening anything) always run. A second LLM reads the draft
# against the snippets it cited, which only pays off on a cloud model, so by
# default it turns on when LLM_BASE_URL points somewhere off this machine.
#   auto           = reviewer on for cloud endpoints, off for local ones
#   deterministic  = never call the reviewer
#   llm            = always call the reviewer, even against a local model
EVIDENCE_GATE_MODE=auto

# Write tools (link/unlink/connect, memory write/delete) pause for a human in
# the chat UI. Set to off to restore the previous always-allow behaviour.
# Approval waits are process-local: the replica that started the turn is the
# one that must receive POST /api/chat/approve.
# ASK_APPROVAL_MODE=on
# ASK_APPROVAL_TIMEOUT=120

# External MCP tools the chat agent may call. JSON object of server name ->
# {command|url, args, allow: [remote tool names]}. Tools not on `allow` arrive
# as ask. Copy mcp_servers.example.json to mcp_servers.json, or set MCP_SERVERS.
# MCP_SERVERS_FILE=
# MCP_SERVERS=

# How many times a 429/5xx model call is retried before the turn fails.
# AGENT_LLM_RETRIES=3

# Model for the reviewer only. Defaults to LLM_MODEL. When the main agent uses
# a large reasoning / pro model, set a cheap flash model here, e.g.:
# JUDGE_MODEL=deepseek-v4-flash

# Compare runs one LLM call per paper plus one to synthesise, so the token
# ceiling is paid several times over. High COMPARE_REASONING_EFFORT spends
# part of it on thinking before the JSON starts — raise the ceiling if parse
# fails with truncated objects. Lower it only if your local model is too slow.
COMPARE_MAX_TOKENS=8192

# Same ceiling for comparisons the chat agent runs mid-conversation, where the
# wait is more noticeable. Defaults to COMPARE_MAX_TOKENS.
# AGENT_COMPARE_MAX_TOKENS=4096
